# Apache rules for the Active24 hosting. `npm run build:active24` copies this
# into dist/ next to index.html; the Vercel build never includes it.

Options -Indexes
AddDefaultCharset UTF-8
# The hosting's defaults may prefer index.php; the site is index.html only.
DirectoryIndex index.html

# Astro ships a 404 page; without this Apache would show its own.
ErrorDocument 404 /404.html

# One canonical origin: https, no www — the same as SITE_URL in src/consts.ts.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Everything under /_astro/ carries a content hash in its name, so it can be
  # cached forever; HTML must always be revalidated so a deploy shows at once.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2?|png|jpe?g|webp|svg|ico)$">
    Header setifempty Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
