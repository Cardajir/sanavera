---
import {
  SITE_NAME,
  SITE_TITLE,
  SITE_TITLE_SUFFIX,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
} from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image-v2.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

/* The home page carries the client's full title; every other page hangs its
   own name in front of the shorter practice-plus-town suffix. */
const pageTitle = title ? `${title} | ${SITE_TITLE_SUFFIX}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />

{
  /* The design sets almost everything bold, but both weights appear above the
     fold, so both are preloaded rather than discovered from the stylesheet. */
}
<link
  rel="preload"
  href="/fonts/youth-bold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/youth-regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={SITE_KEYWORDS} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
