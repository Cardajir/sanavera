---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import RichText from "@/components/RichText.astro";
import Img from "@/components/Img.astro";
import Icon from "@/components/Icon.astro";
import logo from "@/assets/logo.svg";
import SectionLabel from "@/components/SectionLabel.astro";
import PillLink from "@/components/PillLink.astro";
import PillButton from "@/components/PillButton.astro";
import RoundCta from "@/components/RoundCta.astro";
import Slider from "@/components/Slider.astro";
import Stars from "@/components/Stars.astro";
import BookingForm from "@/components/BookingForm.astro";
import Modal from "@/components/Modal.astro";
import ModalController from "@/components/ModalController.astro";
import BookingFormController from "@/components/BookingFormController.astro";
import SliderController from "@/components/SliderController.astro";
import { getCollection, render } from "astro:content";
import { image } from "@/utils/images.ts";
import {
  hero,
  values,
  doctor,
  comfort,
  comfortItems,
  technology,
  services,
  pricing,
  reviews,
  reviewSource,
  contact,
} from "@/data/site.ts";

/** The four modals are all panel collections with the same shape. */
const MODALS = [
  { id: "tym", label: "Náš tým", collection: "tym" as const },
  { id: "pristup", label: "Náš přístup", collection: "pristup" as const },
  {
    id: "vybaveni",
    label: "Vybavení ordinace",
    collection: "vybaveni" as const,
  },
  { id: "sluzby", label: "Poskytované služby", collection: "sluzby" as const },
];

const modals = await Promise.all(
  MODALS.map(async (modal) => {
    const entries = (await getCollection(modal.collection)).sort(
      (a, b) => a.data.order - b.data.order,
    );
    const panels = await Promise.all(
      entries.map(async (entry) => ({
        entry,
        Content: (await render(entry)).Content,
      })),
    );
    return { ...modal, entries, panels };
  }),
);

const sluzby = modals.find((m) => m.id === "sluzby")!.entries;
---

<Layout>
  {/* ============================================================== HERO */}
  {
    /* paddingTop is left at the default so Section emits no padding utility —
       the hero's own top gap is bespoke and set in site.css, and a utility
       would outrank it. */
  }
  <Section paddingBottom="medium" gap="8" class="hero_section">
    <div class="hero_media">
      <Img
        src={image("hero")}
        alt="Ošetření pacientky v ordinaci Sanavera"
        variant="full-width"
        loading="eager"
        fetchPriority="high"
        class="hero_photo"
      />
      <div class="hero_map">
        <iframe
          class="hero_map_image"
          data-map-src="https://snazzymaps.com/embed/808711"
          title={`Mapa – ${contact.clinic.street}, ${contact.clinic.city}`}
          loading="lazy"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
        <div class="hero_map_card glass">
          <p class="address address--small">
            <strong>{contact.clinic.name}</strong><br />
            {contact.clinic.street}<br />
            {contact.clinic.city}
          </p>
          <PillLink href={contact.mapHref} target="_blank" rel="noopener"
            >mapa</PillLink
          >
        </div>
      </div>
    </div>

    <div class="hero_head_text">
      <SectionLabel>{hero.eyebrow}</SectionLabel>
      <Heading tag="h1" variant="display" maxWidth={30}>{hero.heading}</Heading>
    </div>
  </Section>

  {/* ========================================================== KDO JSME */}
  <Section paddingTop="small" paddingBottom="small" id="kdo-jsme">
    <div class="doctor">
      <Img
        src={image("doctor")}
        alt={doctor.name}
        variant="constrained"
        width={900}
        class="doctor_photo"
      />
      <div class="doctor_card">
        <Heading tag="h2" variant="h2">{doctor.heading}</Heading>
        {doctor.bio.map((para) => <Paragraph>{para}</Paragraph>)}
        <p class="doctor_name">{doctor.name}</p>
        <PillButton opens="tym:mddr-veronika-netopilik-kopecna"
          >{doctor.cta}</PillButton
        >
      </div>
    </div>
  </Section>

  {/* =========================================================== RECENZE */}
  <Section paddingTop="small" paddingBottom="8">
    <Slider label="Recenze pacientů" itemWidth="32.375rem">
      {
        reviews.map((review) => (
          <li class="review_card">
            <div class="review_card_head">
              <Heading tag="h2" variant="h2">
                {review.author}
              </Heading>
              <Stars />
            </div>
            <blockquote class="review_card_quote">
              <p>{review.text}</p>
            </blockquote>
            <p class="review_card_source">
              {reviewSource.label}{" "}
              <a
                href={reviewSource.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {reviewSource.linkText}
              </a>
            </p>
          </li>
        ))
      }
    </Slider>
  </Section>

  <Section paddingTop="small" paddingBottom="medium">
    <Heading tag="h2" variant="display" maxWidth={44}>{hero.claim}</Heading>
  </Section>

  <Section paddingTop="8" paddingBottom="small">
    <div class="values">
      {
        values.map((card) => (
          <article class="value_card">
            <Heading tag="h3" variant="h2">
              {card.heading}
            </Heading>
            <Paragraph>{card.text}</Paragraph>
            {card.opens && (
              <PillButton opens={card.opens} class="value_card_link">
                To mě zajímá
              </PillButton>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  {/* ========================================================= OBJEDNÁNÍ */}
  <Section paddingTop="1" paddingBottom="medium" id="objednani">
    <BookingForm formId="booking-objednani" />
  </Section>

  {/* ======================================================= TECHNOLOGIE */}
  <Section paddingTop="medium" paddingBottom="7" gap="large" id="technologie">
    <div class="hero_head_text">
      <SectionLabel>{technology.eyebrow}</SectionLabel>
      <Heading tag="h2" variant="display">
        {technology.heading}
      </Heading>
    </div>

    {/* Three photo cards, each opening its equipment panel. */}
    <ul class="tech">
      {
        technology.items.map((item) => (
          <li class="tech_card">
            <Img
              src={image(item.image)}
              alt={item.product}
              variant="constrained"
              width={700}
              class="tech_card_photo"
            />
            <div class="tech_card_body">
              <p class="tech_card_product">{item.product}</p>
              <Paragraph>{item.text}</Paragraph>
              <PillButton opens={item.opens} class="tech_card_link">
                To mě zajímá
              </PillButton>
            </div>
          </li>
        ))
      }
    </ul>

    {/* The comfort headline stands on its own — no eyebrow — on the board. */}
    <Heading tag="h2" variant="display" class="comfort_heading">
      {comfort.heading}
    </Heading>

    <Slider label="Vybavení pro váš komfort" itemWidth="32.375rem">
      {
        comfortItems.map((item, i) => (
          <>
            <li class="comfort_card" data-product={item.image}>
              <Heading tag="h3" variant="h3">
                {item.heading}
              </Heading>
              <div class="comfort_card_visual">
                <Img
                  src={image(item.image)}
                  alt={item.product}
                  variant="constrained"
                  width={520}
                  transparent
                />
              </div>
              <div class="comfort_card_body">
                <p class="comfort_card_product">{item.product}</p>
                <Paragraph>{item.text}</Paragraph>
              </div>
            </li>
            {/* The design slots a wide photo in as the second slide. */}
            {i === 0 && (
              <li class="comfort_photo">
                <Img
                  src={image("headphones-patient")}
                  alt="Pacient se sluchátky a AR brýlemi během ošetření"
                  variant="constrained"
                  width={1000}
                  class="comfort_photo_image"
                />
              </li>
            )}
          </>
        ))
      }
    </Slider>
  </Section>

  {/* ============================================================ SLUŽBY */}
  {
    /* 143 design px from the last card to the CENÍK label — split with the
       price list's own top padding so both sections keep a step of the scale. */
  }
  <Section paddingTop="large" paddingBottom="6" gap="large" id="sluzby">
    <div class="hero_head_text">
      <SectionLabel>{services.eyebrow}</SectionLabel>
      <Heading tag="h2" variant="display">
        {services.heading}
      </Heading>
    </div>

    <ul class="services">
      {
        sluzby.map((entry, i) => (
          <li class="service_card">
            <p class="service_card_number">{String(i + 1).padStart(2, "0")}</p>
            <Heading tag="h3" variant="h2">
              {entry.data.title}
            </Heading>
            <Paragraph>{entry.data.lead}</Paragraph>
            <PillButton opens={`sluzby:${entry.id}`} class="service_card_link">
              To mě zajímá
            </PillButton>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ============================================================= CENÍK */}
  {
    /* No padding props on purpose: those emit utilities, which would outrank
       the exact paddings site.css gives this section. */
  }
  <Section gap="0" id="cenik">
    <div class="hero_head_text">
      <SectionLabel>{pricing.eyebrow}</SectionLabel>
      <Heading tag="h2" variant="display">
        {pricing.heading}
      </Heading>
    </div>

    <div class="pricing">
      <dl class="pricing_list">
        {
          pricing.items.map((item) => (
            <div class="pricing_row">
              <dt>{item.name}</dt>
              <dd>{item.price}</dd>
            </div>
          ))
        }
      </dl>
      <p class="pricing_note">{pricing.note}</p>
    </div>
  </Section>

  {/* ============================================================ MODALS */}
  {
    /* Every modal renders the same way now: the sidebar lists the panels and
       each panel is a title, a lead and the Markdown body. */
  }
  {
    modals.map((modal) => {
      /* The team boards put one wide portrait straight under the name; every
         other modal keeps its product shots in the square gallery at the
         foot of the panel. */
      const portrait = modal.id === "tym";
      /* Only the services board opens with a bold lead over the narrower of
         the design's two columns. The team, approach and equipment boards
         run straight into the body copy at the full column width. */
      const narrow = modal.id === "sluzby";
      return (
        <Modal
          id={modal.id}
          label={modal.label}
          sidebarLabel={modal.label}
          items={modal.entries.map((e) => ({
            key: e.id,
            label: e.data.navLabel,
          }))}
        >
          {modal.panels.map(({ entry, Content }) => (
            <article
              class:list={[
                "modal_panel",
                portrait && "modal_panel--portrait",
                narrow && "modal_panel--narrow",
              ]}
              data-panel={entry.id}
              hidden
            >
              <Heading tag="h2" variant="h1">
                {entry.data.title}
              </Heading>
              {portrait && entry.data.images.length > 0 && (
                <Img
                  src={image(entry.data.images[0])}
                  alt={entry.data.title}
                  variant="constrained"
                  width={1000}
                  class="modal_portrait"
                />
              )}
              {narrow ? (
                <Paragraph variant="h2" class="modal_lead">
                  {entry.data.lead}
                </Paragraph>
              ) : (
                <Paragraph>{entry.data.lead}</Paragraph>
              )}
              <RichText>
                <Content />
              </RichText>
              {entry.data.logo && (
                <div class="modal_logo">
                  <Icon src={logo} variant="full-width" />
                </div>
              )}
              {!portrait &&
                entry.data.images.map((name) => (
                  <Img
                    src={image(name)}
                    alt={entry.data.title}
                    variant="constrained"
                    width={1000}
                    class="modal_photo"
                  />
                ))}
            </article>
          ))}
        </Modal>
      );
    })
  }

  {
    /* Booking as a dialog, opened from the bar and the floating disc. The
       artboard for it was left empty, so it carries the same peach panel the
       page already uses further down rather than a shape of its own. */
  }
  <Modal
    id="objednat"
    label="Objednat se"
    items={[{ key: "formular", label: "Objednat se" }]}
  >
    <article class="modal_panel modal_panel--cta" data-panel="formular">
      <BookingForm formId="booking-modal" />
    </article>
  </Modal>

  <RoundCta opens="objednat" />

  <ModalController />
  <BookingFormController />
  <SliderController />
</Layout>

<style is:global>
  @layer components {
    /* Anchored sections have to clear the sticky bar when jumped to. */
    [id="kdo-jsme"],
    [id="technologie"],
    [id="sluzby"],
    [id="cenik"],
    [id="objednani"] {
      scroll-margin-top: calc(var(--nav-height) + var(--space-4));
    }

    /* ---------------------------------------------------------- hero */

    /* Wide photo with the map beside it, then the headline underneath —
       the order the design uses. */
    .hero_media {
      display: grid;
      gap: var(--site-gutter);
      grid-template-columns: 1fr;
      width: 100%;

      /* The design's own 1181 : 650 split rather than a rounded ratio, so both
         halves land on the same height as well as the same widths. */
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1181fr) minmax(0, 650fr);
      }
    }

    .hero_photo {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-main);
      object-fit: cover;

      /* 1181 x 672 in the design. */
      @media (width >= 48rem) {
        aspect-ratio: 1181 / 672;
      }
    }

    .hero_map {
      position: relative;
      border-radius: var(--radius-main);
      overflow: clip;
      background-color: var(--sand);
      aspect-ratio: 368 / 378;

      /* 650 x 672 in the design. Side by side the photograph sets the row
         height and this stretches to it — its own ratio would round to a
         few pixels taller and break the shared baseline. */
      @media (width >= 48rem) {
        aspect-ratio: auto;
      }
    }

    .hero_map_image {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      /* A frame paints in its own layer and is not clipped by the rounded
         corner on its parent, so it carries the radius itself. */
      border-radius: inherit;
    }

    /* 611 x 108 in the design, 17px in from the map's edges. */
    .hero_map_card {
      position: absolute;
      inset-block-end: var(--space-3);
      inset-inline: var(--space-3);
      max-width: 38.1875rem;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--panel-inset);
      border-radius: var(--radius-small);

      /* The mobile board stacks the address over the button; the desktop one
         sets them side by side in a 108px-tall bar. That only happens once the
         panel is wide enough to hold both — below 80rem it is not, and the
         row would push the button out of the card. */
      @media (width >= 80rem) {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        min-height: 6.75rem;
      }
    }

    /* Headline on the left, the round booking disc on the right. */
    .hero_head_text {
      display: flex;
      flex-direction: column;
      /* 43-51px from the label's top to the heading's in the design. The
         pattern layer gives the heading its own top margin, which stacked on
         the flex gap and pushed the pair 27px apart too far. */
      gap: 2.3125rem;

      > .heading {
        margin-top: 0;
        /* 1151px at the design width, 332 on the mobile board. */
        max-width: clamp(20.75rem, 7.576rem + 53.635vw, 71.9375rem);
      }
      width: 100%;
      min-width: 0;

      /* The mobile board opens with the headline and drops the eyebrow, so
         the photographs follow the sentence instead of leading it. */
      @media (width < 64rem) {
        order: -1;

        .section_label {
          display: none;
        }
      }
    }

    /* -------------------------------------------------------- kdo jsme */

    .doctor {
      display: grid;
      gap: var(--space-7) var(--site-gutter);
      grid-template-columns: 1fr;
      align-items: stretch;
      width: 100%;
      /* The photograph eases down from scale 1.06, so it has to be clipped to
         its frame — unclipped it spills past the viewport and adds horizontal
         scroll until the reveal fires. */
      overflow: clip;

      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }
    }

    .doctor_photo {
      width: 100%;
      height: 100%;
      min-height: 18rem;
      border-radius: var(--radius-main);
      object-fit: cover;

      /* 916 x 852 in the design; the portrait sets the row height so the
         card beside it stretches to match. */
      @media (width >= 48rem) {
        aspect-ratio: 916 / 852;
        height: auto;
        min-height: 0;
      }
    }

    .doctor_card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.125rem;
      padding: clamp(1.6875rem, 0.8834rem + 3.2744vw, 4.8125rem)
        clamp(1.5rem, 1.0174rem + 1.9646vw, 3.375rem)
        clamp(2rem, 1.7588rem + 0.9823vw, 2.9375rem);
      background-color: var(--light-100);
      border-radius: var(--radius-main);

      /* The card's own padding already sets the title 77px down; the pattern
         layer's heading margin was adding to it. */
      > .heading {
        margin-top: 0;
      }
    }

    /* The name sits well clear of the copy above it — 608px into the card at
       the design width. */
    .doctor_card > .doctor_name {
      margin-block-start: clamp(2.5rem, 0.6083rem + 7.7407vw, 7.75rem);
    }

    /* 26 design px, in the regular weight — a pull-quote, not a heading. */
    /* The design drops the CTA a long way clear of the name. */
    .doctor_card > .pill {
      margin-block-start: clamp(1.5rem, 0.4173rem + 4.4074vw, 5.75rem);
    }

    .doctor_insurance {
      font-size: 1.225rem;
      font-weight: var(--primary-regular);
      line-height: var(--line-height-large);
      letter-spacing: var(--letter-spacing-tight);
    }

    .doctor_name {
      margin-top: auto;
      padding-bottom: var(--space-2);
      font-size: var(--h3);
      font-weight: var(--primary-bold);
      letter-spacing: var(--letter-spacing-tight);
    }

    /* The design lays cards out as three 518px columns with a 12px gutter,
       inset from the content column rather than filling it. */
    .values,
    .services {
      /* Same reason as .slider: the container start-aligns its children. */
      align-self: stretch;
      display: grid;
      gap: var(--site-gutter);
      grid-template-columns: 1fr;
      margin: 0;
      margin-inline: var(--narrow-inset);
      padding: 0;
      list-style: none;

      @media (width >= 40rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    /* Two 316px cards side by side running off the right edge, rather than
       the full-width stack a one-column grid would give. */
    @media (width < 40rem) {
      .values {
        display: flex;
        margin-inline: calc(var(--site-margin) * -1);
        padding-inline: var(--site-margin);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        /* Without this the snapport starts at the border edge and mandatory
           snapping scrolls the leading inset straight back off. */
        scroll-padding-inline-start: var(--site-margin);
        scrollbar-width: none;
        overscroll-behavior-x: contain;

        &::-webkit-scrollbar {
          display: none;
        }

        > * {
          flex: 0 0 calc(100vw - 4.8125rem);
          scroll-snap-align: start;
        }
      }
    }

    .value_card,
    .service_card {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      /* 47/48 design px inset = 35px, on a 518x546 card. */
      padding: var(--card-padding);
      background-color: var(--sand);
      border-radius: var(--radius-main);
      transition: background-color 250ms;

      /* The pattern layer gives every heading a top margin sized to its own
         variant, so the same padding put the value card's title 45px lower
         than the comfort card's and the service card's lower still. The card
         padding is the whole inset; whatever opens the card starts on it. */
      > :first-child {
        margin-top: 0;
      }
    }

    /* The value cards are the one family the design insets deeper along the
       block axis than at the sides: the heading's cap starts 72 design px
       down and the pill leaves 54 below it, against 47 either side. Kept as
       ratios of that side inset so they hold at every width. */
    .value_card {
      padding-block: calc(var(--card-padding) * 1.536)
        calc(var(--card-padding) * 1.149);
    }

    /* The mobile board keeps 30px under the button against the 24 it keeps at
       the sides, where the shared padding was giving 23 on a service card and
       26 on a value one — the button read as sitting on the card's edge. The
       board's own 30 still sat tight, so it opens out to 40 as the cards grow
       toward the desktop layout. */
    @media (width < 48rem) {
      .value_card,
      .service_card {
        padding-block-end: clamp(1.875rem, 1.279rem + 2.545vw, 2.5rem);
      }
    }

    /* 546px tall at the design width; content-height on narrow screens. */
    @media (width >= 64rem) {
      .value_card,
      .service_card,
      .review_card {
        min-height: 34.125rem;
      }

      .comfort_card {
        min-height: 39rem;
      }
    }

    /* Both components ship a peach hover state in the design, but only the
       cards that open something should offer it — the third value card has
       no button and lighting it up promises a click that does nothing.
       Keyed off the trigger itself, so a card gains the state by gaining a
       button rather than by someone remembering to add a class. */
    @media (hover: hover) {
      .value_card:has([data-modal-open]):hover,
      .service_card:has([data-modal-open]):hover {
        background-color: var(--brand-500);
        background-image: var(--brand-wash);
      }
    }

    .service_card_number {
      font-size: var(--text-ui);
      font-weight: var(--primary-bold);
      letter-spacing: var(--letter-spacing-normal);
    }

    .value_card_link {
      margin-top: auto;
      align-self: flex-start;
    }

    /* Below the desktop layout a card is only as tall as its text, so the
       button's `margin-top: auto` has nothing left to absorb and the gap
       above it falls to the card's own row gap — 14px — and the button reads
       as stuck to the copy. A floor on the paragraph holds it at 40.

       It has to cover both families. Only the longest card in a row runs out
       of slack, so measuring the first one says everything is fine while the
       tallest is the one that looks wrong. Cards that do have slack are
       carried with it: the row levels their heights either way. Not bounded
       to the phone — at 1024 the min-height takes over but the longest card
       already exceeds it, so the gap collapsed there too. */
    .value_card > .text:last-of-type,
    .service_card > .text:last-of-type {
      margin-block-end: calc(2.5rem - var(--space-3));
    }

    /* ------------------------------------------------------------ ceník */

    /* The design draws this pair 69 design px apart, cap to cap — a shade
       more than the shared header's gap. */
    [id="cenik"] .hero_head_text {
      gap: 2.625rem;
    }

    /* The design frame wraps greedily: "…navrhneme na míru / na základě
       komplexního vstupního / vyšetření". Balancing would even the lines out
       and lose that shape. */
    [id="cenik"] .heading {
      text-wrap: wrap;
    }

    /* The list sits on the inner column like the cards above it, 141 design
       px from the heading's last baseline to the first rule at the design
       width, easing down to 48px on a phone. */
    .pricing {
      align-self: stretch;
      margin-inline: var(--narrow-inset);
