# EmailJS — https://dashboard.emailjs.com
#
# All three are PUBLIC by design: EmailJS is a browser SDK, so these values
# ship inside the page and anyone can read them. That is expected. What stops
# them being abused is configured in the dashboard, not here:
#
#   1. Account -> Security -> add sanavera.cz to the allowlist, so the key
#      only works from your own domain.
#   2. Account -> Security -> turn on "Block headless browsers".
#   3. Email Services -> the practice's mail service -> keep reCAPTCHA on.
#
# Never put the EmailJS *Private Key* in here — it is for server-side calls
# only and would be exposed to every visitor.

PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
